# ================================================================
# ToolFix Demo 环境变量（本文件已被 .gitignore 排除，严禁提交）
# 填写方式：编辑对应条目后保存，docker compose 会自动读取本文件
# ================================================================

# ---------- ① LLM 大模型配置【待填：等你提供 API Key】----------
# 提供商: dashscope=阿里通义千问 | zhipu=智谱GLM | openai
LLM_PROVIDER=zhipu
LLM_API_KEY=
LLM_MODEL=glm-4.5v
# 文本模型：诊断对话用
LLM_TEXT_MODEL=glm-4.6
# 视觉调用禁用思维链(省token提速)
LLM_DISABLE_THINKING=true
# 演示账号
DEMO_ADMIN_EMAIL=demo@toolfix.com
DEMO_ADMIN_PASSWORD=demo123
# 网关地址（留空 = 使用官方默认地址；中转/代理才需要填）
LLM_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4

# ---------- ② 数据库（本地演示默认值即可）----------
MYSQL_ROOT_PASSWORD=root123
MYSQL_DATABASE=toolfix
MYSQL_USER=toolfix
MYSQL_PASSWORD=toolfix123

# ---------- ③ 后端安全 ----------
# HMAC 诊断链接签名密钥（本次已随机生成，无需改动）
HMAC_SECRET=please-run-openssl-rand-hex-32

# ---------- ④ 邮件通知（走本地 MailHog，无需改）----------
SELLER_EMAIL=seller@toolfix.demo
